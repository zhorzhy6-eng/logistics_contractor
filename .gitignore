# ─────────────────────────────────────────────────────────────
# Секреты и локальные настройки (Шаг 6 задания по безопасности)
# ─────────────────────────────────────────────────────────────
# settings.json содержит только несекретные настройки, но он локальный:
# у каждого пользователя свой. Образец — settings.example.json.
config/settings.json
config/*.local.json
АПИ*.txt
*.key
*.pem

# ─────────────────────────────────────────────────────────────
# База данных и резервные копии
# ─────────────────────────────────────────────────────────────
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backup/

# ─────────────────────────────────────────────────────────────
# Логи (могут содержать рабочие данные)
# ─────────────────────────────────────────────────────────────
logs/
logs/import_bench*.json
*.log
*.log.*

# ─────────────────────────────────────────────────────────────
# Готовые договоры
# ─────────────────────────────────────────────────────────────
output/
*.docx
# Шаблоны договоров — часть проекта, их игнорировать нельзя
!templates/shablon_ooo.docx
!templates/shablon_ip_with_vat.docx
!templates/shablon_ip_without_vat.docx
# Шаблон Формики (ЭТАП 3.1.A) и образец, по которому он собран:
# образец — источник структуры, только чтение, но должен быть в git.
!templates/shablon_formika.docx
!templates/Заявка_ТЛ_447 Формика_Технологистика.docx
# Шаблоны «Логистикс Рус» (ЭТАП 3.1.C.A) и два образца, по которым они
# собраны: образцы — источник структуры и формулировок, только чтение,
# но должны быть в git (иначе их нечем восстановить).
!templates/shablon_logistiks_rus_ooo.docx
!templates/shablon_logistiks_rus_ip.docx
!templates/Приложение № 1 Заявка_600_ООО «ДжейСиСиТиЭс Интернейшнл Логистикс Рус».docx
!templates/Приложение № 1 Заявка_359_ИП_ «ДжейСиСиТиЭс Интернейшнл Логистикс Рус».docx
# Шаблоны разовой аренды ТС с экипажем (ЭТАП 3.1.D.A.1) — часть проекта.
!templates/shablon_arenda_ts_ooo.docx
!templates/shablon_arenda_ts_ip_with_vat.docx
!templates/shablon_arenda_ts_ip_without_vat.docx
# Образец договора аренды ТС с экипажем (шаг 3.1.D.A.2) в git НЕ хранится:
# в нём реальные персональные данные водителя (ФИО, паспорт, серия и номер,
# адрес регистрации, телефон) — это нарушение 152-ФЗ даже в приватном
# репозитории. Файл нужен ЛОКАЛЬНО: из него собираются шаблоны
# (tools/make_arenda_ts_template.py) и по нему сверяется SHA256 в
# tests/test_arenda_ts_template.py (тест пропускается, если файла нет).
# В коммите 34711f9 образец остался в истории; чистка истории
# (git filter-repo/BFG + force push) — отдельная задача.
templates/Договор_аренды_ТС_с_экипажем_ТЛ-574_*.docx
templates/*.xlsx
# Бланк Хавалов (ЭТАП 3.1.E.A.1) и образец, по которому он собран:
# строка templates/*.xlsx выше игнорирует все xlsx, поэтому оба файла
# возвращаются в git явными исключениями. Оригинал templates/Хавалы.xlsx
# остаётся локальным: в git идёт его копия Хавалы_образец.xlsx
# (ПДн третьих лиц в образце нет — только шапка, пример даты и стороны).
!templates/shablon_havaly.xlsx
!templates/Хавалы_образец.xlsx

# ─────────────────────────────────────────────────────────────
# Золотые эталоны договоров (Шаг 0 рефакторинга контрактов)
# ─────────────────────────────────────────────────────────────
!tests/data/golden/
!tests/data/golden/*.docx
!tests/_tmp/baseline.txt

