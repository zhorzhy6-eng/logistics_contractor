# ─────────────────────────────────────────────────────────────
# Секреты и локальные настройки (Шаг 6 задания по безопасности)
# ─────────────────────────────────────────────────────────────
# settings.json содержит только несекретные настройки, но он локальный:
# у каждого пользователя свой. Образец — settings.example.json.
config/settings.json
config/*.local.json
АПИ*.txt
*.key
*.pem

# ─────────────────────────────────────────────────────────────
# База данных и резервные копии
# ─────────────────────────────────────────────────────────────
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backup/

# ─────────────────────────────────────────────────────────────
# Логи (могут содержать рабочие данные)
# ─────────────────────────────────────────────────────────────
logs/
logs/import_bench*.json
*.log
*.log.*

# ─────────────────────────────────────────────────────────────
# Готовые договоры
# ─────────────────────────────────────────────────────────────
output/
*.docx
# Шаблоны договоров — часть проекта, их игнорировать нельзя
!templates/shablon_ooo.docx
!templates/shablon_ip_with_vat.docx
!templates/shablon_ip_without_vat.docx
templates/*.xlsx

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
tests/_tmp/
_pytest_tmp/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ─────────────────────────────────────────────────────────────
# Сборка
# ─────────────────────────────────────────────────────────────
build/
dist/
*.spec

# ─────────────────────────────────────────────────────────────
# Прочее
# ─────────────────────────────────────────────────────────────
*.tmp
~$*
.DS_Store
Thumbs.db
Новая папка/

# ─────────────────────────────────────────────────────────────
# Секреты: файлы окружения (дополнение при переводе проекта под git)
# ─────────────────────────────────────────────────────────────
.env
.env.*
env/
ENV/

# ─────────────────────────────────────────────────────────────
# Покрытие тестами
# ─────────────────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/

# ─────────────────────────────────────────────────────────────
# Отчётные артефакты разработки (выгрузки тестов, дампы, патчи)
# ─────────────────────────────────────────────────────────────
tests_*.txt
project_tree_clean.txt
_for_analysis.txt
_dump_doc.py
demo_route_tables.py
*.patch
