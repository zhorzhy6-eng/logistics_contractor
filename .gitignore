# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
tests/_tmp/*
!tests/_tmp/baseline.txt
_pytest_tmp/
.mypy_cache/
.ruff_cache/
.venv/
venv/

