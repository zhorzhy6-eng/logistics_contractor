# ─────────────────────────────────────────────────────────────
# Документы для распознавания (локальная папка оператора)
# ─────────────────────────────────────────────────────────────
# Сканы и фотографии документов водителей, организаций и машин: в них
# реальные персональные данные (ФИО, паспорта, адреса). Папка нужна
# ЛОКАЛЬНО — для проверки распознавания и импорта, в git не попадает
# (AGENTS.md § 4). Тесты работают только на синтетических документах.
# ВНИМАНИЕ: имя папки на диске — с опечаткой («Документы для распознования»,
# без «а» после «н»), поэтому здесь МАСКА, а не точное имя: одна ошибка в
# букве уже стоила бы того, что `git add -A` отправил бы ПДн в репозиторий.
# Маска закрывает и это имя, и правильное написание.
Документы для распоз*/

# ─────────────────────────────────────────────────────────────
# Входные файлы справочника салонов (ШАГ FIX-2.2)
# ─────────────────────────────────────────────────────────────
# В git идёт САНИТИЗИРОВАННЫЙ справочник мест выгрузки
# (data/spravochnik_mest_vygruzki.xlsx): только деловые графы — код, ИНН,
# юр. лицо, город, юридический адрес, адрес доставки и комментарии о графике.
# Оригинал «Места выгрузок.xlsx» содержит ПДн (e-mail получателей
# уведомлений, контактные телефоны, ФИО региональных менеджеров), поэтому
# хранится ЛОКАЛЬНО в data/private/ и в git не попадает (AGENTS.md § 4).
# Пересобрать файл проекта: python tools/make_salons_reference.py
data/private/

# ─────────────────────────────────────────────────────────────
# Секреты и локальные настройки (Шаг 6 задания по безопасности)
# ─────────────────────────────────────────────────────────────
# settings.json содержит только несекретные настройки, но он локальный:
# у каждого пользователя свой. Образец — settings.example.json.
config/settings.json
config/*.local.json
АПИ*.txt
*.key
*.pem

# ─────────────────────────────────────────────────────────────
# База данных и резервные копии
# ─────────────────────────────────────────────────────────────
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backup/

# ─────────────────────────────────────────────────────────────
# Логи (могут содержать рабочие данные)
# ─────────────────────────────────────────────────────────────
logs/
logs/import_bench*.json
*.log
*.log.*

# ─────────────────────────────────────────────────────────────
# Готовые договоры
# ─────────────────────────────────────────────────────────────
output/
*.docx
# Бланки договоров — часть проекта, их игнорировать нельзя.
# Публичными остаются три бланка «Экспедиторства» (рабочий тип).
!templates/shablon_ooo.docx
!templates/shablon_ip_with_vat.docx
!templates/shablon_ip_without_vat.docx
# Бланки и образцы клиентских типов в публичном репозитории НЕ хранятся:
# они лежат в приватной части проекта (logistics_contractor_private,
# папка templates/) — см. docs/PRIVATE_MIGRATION.md. Поэтому здесь нет
# ни одного исключения под них: любой новый бланк клиента остаётся
# невидимым для публичного git по общему правилу `*.docx` / `templates/*.xlsx`.
templates/*.xlsx

# ─────────────────────────────────────────────────────────────
# Золотые эталоны договоров (Шаг 0 рефакторинга контрактов)
# ─────────────────────────────────────────────────────────────
!tests/data/golden/
!tests/data/golden/*.docx
!tests/_tmp/baseline.txt

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
tests/_tmp/*
!tests/_tmp/baseline.txt
_pytest_tmp/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ─────────────────────────────────────────────────────────────
# Приватная часть проекта (клиентские типы договоров)
# ─────────────────────────────────────────────────────────────
# Шаблоны, промпты и окна клиентских типов лежат ОТДЕЛЬНОЙ папкой и в этот
# репозиторий не попадают. Обычно папка лежит рядом с проектом
# (E:\Programmy\logistics_contractor_private), но её могут положить
# и внутрь — на этот случай обе маски. См. docs/PRIVATE_MIGRATION.md.
private/
logistics_contractor_private/

# ─────────────────────────────────────────────────────────────
# Сборка
# ─────────────────────────────────────────────────────────────
build/
dist/
*.spec

# ─────────────────────────────────────────────────────────────
# Прочее
# ─────────────────────────────────────────────────────────────
*.tmp
~$*
.DS_Store
Thumbs.db
Новая папка/
# Задания и выжимки по проекту: в них встречаются названия клиентов,
# поэтому файлы хранятся локально (папка приватной части), а не в git.
ПОЛНАЯ ВЫЖИМКА*.txt

# ─────────────────────────────────────────────────────────────
# Секреты: файлы окружения (дополнение при переводе проекта под git)
# ─────────────────────────────────────────────────────────────
.env
.env.*
env/
ENV/

# ─────────────────────────────────────────────────────────────
# Покрытие тестами
# ─────────────────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/

# ─────────────────────────────────────────────────────────────
# Отчётные артефакты разработки (выгрузки тестов, дампы, патчи)
# ─────────────────────────────────────────────────────────────
tests_*.txt
project_tree_clean.txt
_for_analysis.txt
_dump_doc.py
demo_route_tables.py
*.patch
